<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64;x86</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <!-- PackageReference LINQPad.Reference will be added by dotnet add package -->
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LINQPad.Reference" Version="1.3.1" />
  </ItemGroup>
  <Target Name="CopyToLINQPad" AfterTargets="PostBuild" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <LINQPadDriversDir>$(LOCALAPPDATA)\\LINQPad\\Drivers\\DataContext\\NetCore\\DatabricksDriver</LINQPadDriversDir>
    </PropertyGroup>
    <MakeDir Directories="$(LINQPadDriversDir)" Condition="!Exists('$(LINQPadDriversDir)')" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(LINQPadDriversDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).pdb" DestinationFolder="$(LINQPadDriversDir)" SkipUnchangedFiles="true" Condition="Exists('$(OutputPath)$(AssemblyName).pdb')" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).deps.json" DestinationFolder="$(LINQPadDriversDir)" SkipUnchangedFiles="true" Condition="Exists('$(OutputPath)$(AssemblyName).deps.json')" />
  </Target>
</Project>
