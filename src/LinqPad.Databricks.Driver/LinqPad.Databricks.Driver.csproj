<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64;x86</Platforms>
    <AssemblyName>LinqPad.Databricks.Driver</AssemblyName>
    <RootNamespace>LinqPad.Databricks.Driver</RootNamespace>
    <!-- NuGet packaging -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>LinqPad.Databricks.Driver</PackageId>
    <Version>0.1.0</Version>
    <Authors>Databricks LINQPad Driver Contributors</Authors>
    <Description>LINQPad 8+ Data Context Driver for Azure Databricks (Unity Catalog + SQL Warehouse)</Description>
    <PackageTags>linqpaddriver;databricks;azure</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LINQPad.Reference" Version="1.3.1" />
  </ItemGroup>

  <!-- Exclude XAML file from build (WPF is provided by LINQPad host at runtime) -->
  <ItemGroup>
    <None Include="ConnectionDialog.xaml" />
  </ItemGroup>

  <!-- Dev-loop: copy output to LINQPad driver folder on Windows -->
  <Target Name="CopyToLINQPadDrivers" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <LINQPadDriverDir>$(LOCALAPPDATA)\LINQPad\Drivers\DataContext\NetCore\DatabricksDriver</LINQPadDriverDir>
    </PropertyGroup>
    <MakeDir Directories="$(LINQPadDriverDir)" />
    <Copy SourceFiles="@(ReferenceCopyLocalPaths)" DestinationFolder="$(LINQPadDriverDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(LINQPadDriverDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
