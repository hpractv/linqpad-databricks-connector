<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64;x86</Platforms>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LINQPad.Reference">
      <Version>*</Version>
    </PackageReference>
  </ItemGroup>
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <PostBuildEvent>if not exist "$(LOCALAPPDATA)\LINQPad\Drivers\DataContext\NetCore\DatabricksDriver" mkdir "$(LOCALAPPDATA)\LINQPad\Drivers\DataContext\NetCore\DatabricksDriver" &amp;&amp; xcopy /Y /I "$(TargetDir)*" "$(LOCALAPPDATA)\LINQPad\Drivers\DataContext\NetCore\DatabricksDriver\"</PostBuildEvent>
  </PropertyGroup>
</Project>
