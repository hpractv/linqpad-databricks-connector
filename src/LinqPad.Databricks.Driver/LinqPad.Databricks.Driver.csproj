<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64;x86</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LINQPad.Reference">
      <Version>1.3.1</Version>
    </PackageReference>
  </ItemGroup>

  <!-- Copy build outputs to LOCALAPPDATA LINQPad drivers folder on Windows dev machines -->
  <Target Name="PostBuildCopyToLINQPad" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <LinqPadDriverFolder>$(LOCALAPPDATA)\LINQPad\Drivers\DataContext\NetCore\DatabricksDriver</LinqPadDriverFolder>
    </PropertyGroup>

    <MakeDir Directories="$(LinqPadDriverFolder)" Condition="!Exists('$(LinqPadDriverFolder)')" />

    <ItemGroup>
      <DriverFiles Include="$(OutputPath)**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(DriverFiles)" DestinationFolder="$(LinqPadDriverFolder)\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
